[Unit]
Description=Женщины нового времени — Telegram-бот
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
OnFailure=wnw-bot-notify-down@%N.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=__PROJECT_DIR__/.venv/bin/python -m bot.main
Restart=on-failure
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=300

[Install]
WantedBy=multi-user.target
